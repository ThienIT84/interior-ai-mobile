/android/app/release

# Platform runners outside the current Android + Web delivery scope.
# Android and Web runners are source files and must remain versioned.

# iOS platform files (auto-generated by Flutter)
ios/

# Linux platform files (auto-generated by Flutter)
linux/

# macOS platform files (auto-generated by Flutter)
macos/

# Windows platform files (auto-generated by Flutter)
windows/

# Web runner and tests are part of the cross-platform application.
